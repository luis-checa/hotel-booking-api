{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "generated/prisma/**/*.ts",
        "outDir": "dist/src/generated/prisma"
      }
    ],
    "watchAssets": true
  }
}
